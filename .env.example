# 复制为 .env 并填入真实 key；.env 已被 .gitignore 忽略，不会进仓库
#   cp .env.example .env

# ── 必填 ──────────────────────────────────────────────
# DeepSeek 凭证（agent 主循环用）。获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# ── 选填 ──────────────────────────────────────────────
# Brave Search API（web_search 工具用）。不填则 web_search 返回未配置提示。
# 免费额度 2000 次/月：https://brave.com/search/api/
MINI_CC_BRAVE_SEARCH_API_KEY=

# ── 可调参数（都有默认值，一般不用动）─────────────────
# MINI_CC_MAX_TURNS=90              # 主 agent 单轮最大迭代步数
# MINI_CC_MAX_TURNS_SUBAGENT=50     # 子 agent 最大迭代步数
# MINI_CC_MAX_SUBAGENT_DEPTH=2      # 子 agent 最大递归深度
# MINI_CC_MAX_PARALLEL=10           # 并行 spawn 子 agent 的最大并发数
# MINI_CC_SKILL_DIR=skills          # skill 扫描目录
# MINI_CC_SHOW_THINKING=False       # 是否打印思考模式的 reasoning_content
# MINI_CC_AUTO_ALLOW=               # 设为 1/true/yes 跳过权限确认（仅测试/CI 用，勿在生产开）
